{
  "name": "sobretaula",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode test",
    "dev:test": "vite dev --mode test",
    "dev:e2e": "vite dev --mode test --host 127.0.0.1 --port 3001",
    "dev:production": "vite dev --mode production",
    "build": "pnpm typecheck && vite build",
    "build:test": "pnpm typecheck && vite build --mode test",
    "start": "node .output/server/index.mjs",
    "format": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "structure:check": "doscientos-structure --root src --tanstack-router",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:failed": "playwright test --last-failed",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm structure:check && pnpm typecheck && pnpm test",
    "quality:quick": "pnpm format && pnpm lint:fix",
    "hooks:install": "node .githooks/install.mjs"
  },
  "dependencies": {
    "@doscientos/pwa": "0.1.4",
    "@doscientos/ui": "^0.1.39",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "lucide-react": "^1.11.0",
    "nitro": "3.0.260903-beta",
    "node-forge": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@doscientos/configs": "^0.1.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.15.2"
  },
  "packageManager": "pnpm@9.15.2"
}
