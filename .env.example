# Cliente (públicas por diseño, el acceso lo protege RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor (nunca se exponen al bundle cliente)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Fiscalidad: entorno por defecto de nuevos tenants (test | prod)
VERIFACTU_DEFAULT_ENV=test
# Clave maestra de cifrado de certificados por tenant (32 bytes en base64)
TENANT_CERTIFICATE_MASTER_KEY=
