# Cliente (públicas por diseño, el acceso lo protege RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor (nunca se exponen al bundle cliente)
# URL y clave publicable son opcionales: si faltan se reutilizan las VITE_*
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sesión del servidor: cadena aleatoria de al menos 32 caracteres.
SESSION_PASSWORD=

# Clave maestra de cifrado de certificados por tenant (32 bytes en base64)
TENANT_CERTIFICATE_MASTER_KEY=

# Cobros SaaS por Redsys. Configurar valores exclusivos de SobreTaula en el
# gestor de secretos del entorno; nunca copiar ni compartir los del backoffice.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_CURRENCY=978
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
# Base pública para callbacks firmados de Redsys y trabajos internos.
APP_URL=
# Correo público para ejercer derechos de privacidad y consultas legales sobre
# SobreTaula. Es público por diseño; la identidad fiscal se configura en Admin.
LEGAL_CONTACT_EMAIL=
PLATFORM_BILLING_CRON_SECRET=
# Clave rotada de 32 bytes codificada en base64 para cifrar referencias Redsys.
PLATFORM_PAYMENT_REFERENCE_ENCRYPTION_KEY=

# Confirmaciones de reserva por email. Configurar estas variables como secretos
# de la Edge Function de Supabase, nunca en el cliente ni en GitHub Actions.
RESEND_API_KEY=
# Buzón de un dominio verificado en Resend; el nombre visible lo elige cada restaurante.
RESEND_FROM_EMAIL=
NOTIFICATION_CRON_SECRET=
NOTIFICATION_WORKER_TOKEN=
